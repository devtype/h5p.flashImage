    },
    {
      "label": "Blitzbild",
      "fields": [
        {
          "label": "Bild",
          "description": "Bild, das nach dem Start kurz angezeigt wird."
        },
        {
          "label": "Alternativtext",
          "description": "Beschreibt das Blitzbild für Screenreader. Dringend empfohlen, wenn das Bild für die Aufgabe bedeutsam ist."
        },
        {
          "label": "Anzeigedauer (Sekunden)",
          "description": "Wie lange das Bild nach dem Start sichtbar bleibt. Zulässiger Bereich: 0,1–10 Sekunden."
