[
  {
    "name": "intro",
    "label": "Introduction",
    "description": "Optional text shown before the learner starts the image flash. May contain HTML.",
    "type": "text",
    "widget": "html",
    "importance": "low",
    "optional": true,
    "enterMode": "p",
    "tags": [
      "strong",
      "em",
      "u",
      "a",
      "ul",
      "ol",
      "h2",
      "h3",
      "hr",
      "pre",
      "code"
    ]
  },
  {
    "name": "flashimage",
    "type": "group",
    "label": "Flash image",
    "importance": "high",
    "expanded": true,
    "fields": [
      {
        "name": "file",
        "type": "image",
        "label": "Image",
        "description": "Image shown briefly after the learner starts the flash.",
        "importance": "high",
        "optional": false
      },
      {
        "name": "alternativeText",
        "type": "text",
        "label": "Alternative text",
        "description": "Describe the flash image for screen reader users. Strongly recommended whenever the image carries meaning for the task.",
        "optional": true,
        "importance": "high"
      },
      {
        "name": "displayDurationSec",
        "type": "number",
        "label": "Display duration (seconds)",
        "description": "How long the image stays visible after start. Allowed range: 0.1–10 seconds.",
        "default": 1,
        "min": 0.1,
        "max": 10,
        "step": 0.1,
        "importance": "high"
      }
    ]
  },
  {
    "name": "question",
    "type": "text",
    "widget": "html",
    "label": "Question",
    "description": "Question shown after the image flash ends.",
    "importance": "high",
    "default": "<p>What did you see?</p>",
    "enterMode": "p",
    "tags": [
      "strong",
      "em",
      "sub",
      "sup",
      "h2",
      "h3",
      "pre",
      "code"
    ]
  },
  {
    "name": "answers",
    "type": "list",
    "importance": "high",
    "label": "Answer options",
    "entity": "option",
    "min": 2,
    "defaultNum": 2,
    "widget": "flashImageAnswers",
    "field": {
      "name": "answer",
      "type": "group",
      "label": "Option",
      "importance": "high",
      "fields": [
        {
          "name": "text",
          "type": "text",
          "importance": "high",
          "widget": "html",
          "label": "Text",
          "tags": [
            "strong",
            "em",
            "sub",
            "sup",
            "code"
          ]
        },
        {
          "name": "correct",
          "type": "boolean",
          "label": "Correct",
          "importance": "low",
          "default": false
        }
      ]
    }
  },
  {
    "name": "overallFeedback",
    "type": "group",
    "label": "Overall Feedback",
    "importance": "low",
    "expanded": true,
    "fields": [
      {
        "name": "overallFeedback",
        "type": "list",
        "widgets": [
          {
            "name": "RangeList",
            "label": "Default"
          }
        ],
        "importance": "high",
        "label": "Define custom feedback for any score range",
        "description": "Click the \"Add range\" button to add as many ranges as you need. Example: 0-20% Bad score, 21-91% Average Score, 91-100% Great Score!",
        "entity": "range",
        "min": 1,
        "defaultNum": 1,
        "optional": true,
        "field": {
          "name": "overallFeedback",
          "type": "group",
          "importance": "low",
          "fields": [
            {
              "name": "from",
              "type": "number",
              "label": "Score Range",
              "min": 0,
              "max": 100,
              "default": 0,
              "unit": "%"
            },
            {
              "name": "to",
              "type": "number",
              "min": 0,
              "max": 100,
              "default": 100,
              "unit": "%"
            },
            {
              "name": "feedback",
              "type": "text",
              "label": "Feedback for defined score range",
              "importance": "low",
              "placeholder": "Fill in the feedback",
              "optional": true
            }
          ]
        }
      }
    ]
  },
  {
    "name": "behaviour",
    "type": "group",
    "label": "Behavioural settings",
    "importance": "low",
    "expanded": false,
    "fields": [
      {
        "name": "allowRepeatFlash",
        "type": "boolean",
        "label": "Allow repeating the image flash",
        "description": "When enabled, learners see a separate button to flash the image again while answering.",
        "default": true
      },
      {
        "name": "enableCheckButton",
        "type": "boolean",
        "label": "Enable \"Check\" button",
        "default": true
      },
      {
        "name": "enableSolutionsButton",
        "type": "boolean",
        "label": "Enable \"Show solution\" button",
        "default": true
      },
      {
        "name": "enableRetry",
        "type": "boolean",
        "label": "Enable \"Retry\" button",
        "default": true
      },
      {
        "name": "type",
        "type": "select",
        "label": "Question type",
        "description": "Automatic uses radio buttons for one correct answer and checkboxes for several.",
        "default": "auto",
        "options": [
          { "value": "auto", "label": "Automatic" },
          { "value": "single", "label": "Single choice (radio buttons)" },
          { "value": "multi", "label": "Multiple choice (checkboxes)" }
        ]
      },
      {
        "name": "singlePoint",
        "type": "boolean",
        "label": "Give one point for the whole task",
        "description": "When enabled, learners get either full score or zero (all-or-nothing).",
        "default": true
      },
      {
        "name": "randomAnswers",
        "type": "boolean",
        "label": "Randomize answers",
        "default": false
      },
      {
        "name": "maxScore",
        "type": "number",
        "label": "Maximum score",
        "description": "Used when \"Give one point for the whole task\" is disabled. With single-point mode the effective max score is 1.",
        "default": 1,
        "min": 0,
        "max": 100
      },
      {
        "name": "confirmCheckDialog",
        "type": "boolean",
        "label": "Show confirmation dialog on \"Check\"",
        "default": false
      },
      {
        "name": "confirmRetryDialog",
        "type": "boolean",
        "label": "Show confirmation dialog on \"Retry\"",
        "default": false
      }
    ]
  },
  {
    "name": "l10n",
    "type": "group",
    "label": "User interface translations",
    "common": true,
    "importance": "low",
    "expanded": false,
    "fields": [
      {
        "name": "startFlash",
        "type": "text",
        "label": "Start flash button",
        "default": "Start image flash"
      },
      {
        "name": "repeatFlash",
        "type": "text",
        "label": "Repeat flash button",
        "default": "Show image again"
      },
      {
        "name": "loading",
        "type": "text",
        "label": "Loading message",
        "default": "Loading image…"
      },
      {
        "name": "checkAnswer",
        "type": "text",
        "label": "Check button",
        "default": "Check"
      },
      {
        "name": "showSolution",
        "type": "text",
        "label": "Show solution button",
        "default": "Show solution"
      },
      {
        "name": "retry",
        "type": "text",
        "label": "Retry button",
        "default": "Retry"
      },
      {
        "name": "scoreBarLabel",
        "type": "text",
        "label": "Score bar label",
        "description": "Available variables: :num and :total",
        "default": "You got :num out of :total points"
      },
      {
        "name": "noAnswer",
        "type": "text",
        "label": "No answer selected",
        "default": "Please select an answer before checking."
      }
    ]
  },
  {
    "name": "confirmCheck",
    "type": "group",
    "label": "Check confirmation dialog",
    "importance": "low",
    "common": true,
    "fields": [
      {
        "name": "header",
        "type": "text",
        "label": "Header text",
        "default": "Finish ?"
      },
      {
        "name": "body",
        "type": "text",
        "label": "Body text",
        "default": "Are you sure you wish to finish ?",
        "widget": "html",
        "enterMode": "p",
        "tags": ["strong", "em", "del", "u", "code"]
      },
      {
        "name": "cancelLabel",
        "type": "text",
        "label": "Cancel button label",
        "default": "Cancel"
      },
      {
        "name": "confirmLabel",
        "type": "text",
        "label": "Confirm button label",
        "default": "Finish"
      }
    ]
  },
  {
    "name": "confirmRetry",
    "type": "group",
    "label": "Retry confirmation dialog",
    "importance": "low",
    "common": true,
