      {
        "name": "header",
        "type": "text",
        "label": "Header text",
        "default": "Retry ?"
      },
      {
        "name": "body",
        "type": "text",
        "label": "Body text",
        "default": "Are you sure you wish to retry ?",
        "widget": "html",
        "enterMode": "p",
        "tags": ["strong", "em", "del", "u", "code"]
      },
      {
        "name": "cancelLabel",
        "type": "text",
        "label": "Cancel button label",
        "default": "Cancel"
      },
      {
        "name": "confirmLabel",
        "type": "text",
        "label": "Confirm button label",
        "default": "Confirm"
      }
    ]
  },
  {
    "name": "a11y",
    "type": "group",
    "label": "Accessibility translations",
    "common": true,
    "importance": "low",
    "expanded": false,
    "fields": [
      {
        "name": "flashImageLabel",
        "type": "text",
        "label": "Flash image region label",
        "default": "Flash image"
      },
      {
        "name": "answersLabel",
        "type": "text",
        "label": "Answer options label",
        "default": "Answer options"
      },
      {
        "name": "correctAnswer",
        "type": "text",
        "label": "Correct answer announcement",
        "default": "Correct answer"
      },
      {
        "name": "wrongAnswer",
        "type": "text",
        "label": "Wrong answer announcement",
        "default": "Wrong answer"
      },
      {
        "name": "flashStarted",
        "type": "text",
        "label": "Flash started announcement",
        "default": "Image flash started."
      },
      {
        "name": "flashEnded",
        "type": "text",
