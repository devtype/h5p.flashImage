        "min": 0.1,
        "max": 10,
        "importance": "high"
      }
    ]
  },
  {
    "name": "task",
    "type": "library",
    "label": "Task",
    "importance": "high",
    "description": "Complex fill in the blanks task shown after the image is hidden.",
    "options": [
      "H5P.AdvancedBlanks 1.2"
    ]
  },
  {
    "name": "behaviour",
    "type": "group",
    "label": "Behavioural settings",
    "importance": "low",
    "expanded": false,
    "fields": [
      {
        "name": "maxFlashViews",
        "type": "number",
        "label": "Maximum flash views",
        "description": "How many times the learner may see the image in one attempt, including the first flash. Use 0 for unlimited.",
        "default": 1,
        "min": 0,
        "max": 20,
        "importance": "high"
      }
    ]
  },
