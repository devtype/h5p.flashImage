[
  {
    "name": "intro",
    "label": "Introduction",
    "description": "Optional text shown before the learner starts the image flash. May contain HTML.",
    "type": "text",
    "widget": "html",
    "importance": "low",
    "optional": true,
    "enterMode": "p",
    "tags": ["strong", "em", "u", "a", "ul", "ol", "h2", "h3", "hr", "pre", "code"]
  },
  {
    "name": "flashimage",
    "type": "group",
    "label": "Flash image",
    "importance": "high",
    "expanded": true,
    "fields": [
      {
        "name": "file",
        "type": "image",
        "label": "Image",
        "description": "Image shown briefly after the learner starts the flash.",
        "importance": "high",
        "optional": false
      },
      {
        "name": "alternativeText",
        "type": "text",
        "label": "Alternative text",
        "description": "Describe the flash image for screen reader users. Strongly recommended whenever the image carries meaning for the task.",
        "optional": true,
        "importance": "high"
      },
      {
        "name": "displayDurationSec",
        "type": "number",
        "label": "Display duration (seconds)",
        "description": "How long the image stays visible after start. Allowed range: 0.1–10 seconds.",
        "default": 1,
        "min": 0.1,
        "max": 10,
        "importance": "high"
      }
    ]
  },
  {
    "name": "content",
    "type": "group",
    "label": "Question",
    "importance": "high",
    "expanded": true,
    "fields": [
      {
        "name": "task",
        "type": "text",
        "widget": "html",
        "label": "Task description",
        "description": "A guide telling the user how to answer this task.",
        "importance": "high",
        "default": "<p>Fill in the missing words.</p>",
        "enterMode": "p",
        "tags": ["strong", "em", "u", "a", "ul", "ol", "h2", "h3", "hr"]
      },
      {
        "name": "blanksText",
        "type": "text",
        "widget": "html",
        "label": "Text with blanks",
        "description": "Mark each blank with three or more underscores (___). Do not put the answers in the text.",
        "importance": "high",
        "enterMode": "p",
        "tags": ["strong", "em", "u", "ul", "ol", "h2", "h3", "hr", "sub", "sup"]
      },
      {
        "name": "blanksList",
        "type": "list",
        "label": "Answers",
        "importance": "high",
        "entity": "blank",
        "min": 1,
        "defaultNum": 1,
        "field": {
          "name": "blankGroup",
          "type": "group",
          "label": "Blank",
          "fields": [
            {
              "name": "correctAnswerText",
              "type": "text",
              "label": "Correct answer",
              "description": "One answer for this blank, in the same order as the blanks in the text. Separate alternative answers with a slash (/)."
            }
          ]
        }
      }
    ]
  },
  {
    "name": "overallFeedback",
    "type": "group",
    "label": "Overall feedback",
    "importance": "low",
    "expanded": false,
    "fields": [
      {
        "name": "overallFeedback",
        "type": "list",
        "widgets": [{ "name": "RangeList", "label": "Default" }],
        "importance": "high",
        "label": "Define custom feedback for any score range",
        "description": "Click the \"Add range\" button to add as many ranges as you need. Example: 0-20% Bad score, 21-91% Average Score, 91-100% Great Score!",
        "entity": "range",
        "min": 1,
        "defaultNum": 1,
        "optional": true,
        "field": {
          "name": "overallFeedback",
          "type": "group",
          "fields": [
            {
              "name": "from",
              "type": "number",
              "label": "Score range",
              "min": 0,
              "max": 100,
              "default": 0,
              "unit": "%"
            },
            {
              "name": "to",
              "type": "number",
              "min": 0,
              "max": 100,
              "default": 100,
              "unit": "%"
            },
            {
              "name": "feedback",
              "type": "text",
              "label": "Feedback for defined score range",
              "optional": true
            }
          ]
        }
      }
    ]
  },
  {
    "name": "behaviour",
    "type": "group",
    "label": "Behavioural settings",
    "importance": "low",
    "description": "How often the image may be shown, and how the fill-in task behaves.",
    "expanded": false,
    "fields": [
      {
        "name": "maxFlashViews",
        "type": "number",
        "label": "Maximum flash views",
        "description": "How many times the learner may see the image in one attempt, including the first flash. Use 0 for unlimited.",
        "default": 1,
        "min": 0,
        "max": 20,
        "importance": "high"
      },
      {
        "name": "mode",
        "type": "select",
        "label": "Answer mode",
        "description": "Indicates in what way the user gives answers.",
        "options": [
          { "value": "typing", "label": "The user types in the answers." },
          { "value": "selection", "label": "The user selects from options." }
        ],
        "default": "typing"
      },
      {
        "name": "selectAlternatives",
        "type": "select",
        "label": "Alternatives offered for selection",
        "widget": "showWhen",
        "showWhen": { "rules": [{ "field": "mode", "equals": "selection" }] },
        "options": [
          { "value": "alternatives", "label": "The incorrect answers entered for the blank" },
          { "value": "all", "label": "The correct answers of all other blanks" }
        ],
        "default": "alternatives"
      },
      {
        "name": "selectAlternativeRestriction",
        "type": "number",
        "label": "Maximum number of alternatives of other blanks offered for selection",
        "description": "Enter 0 to set no limit.",
        "min": 0,
        "default": 5,
        "widget": "showWhen",
        "showWhen": { "rules": [{ "field": "mode", "equals": "selection" }] }
      },
      {
        "name": "spellingErrorBehaviour",
        "type": "select",
        "label": "Behaviour when the user makes a spelling error",
        "options": [
          { "value": "accept", "label": "Accept it as a correct answer" },
          { "value": "warn", "label": "Warn the user about the error" },
          { "value": "mistake", "label": "Consider it a regular mistake" }
        ],
        "default": "mistake",
        "widget": "showWhen",
        "showWhen": { "rules": [{ "field": "mode", "equals": "typing" }] }
      },
      {
        "name": "caseSensitive",
        "type": "boolean",
        "label": "Case sensitive",
        "description": "If enabled, capitalization that is different from the solution is considered an error.",
        "default": false,
        "widget": "showWhen",
        "showWhen": { "rules": [{ "field": "mode", "equals": "typing" }] }
      },
      {
        "name": "autoCheck",
        "type": "boolean",
        "label": "Automatically check answers after input",
        "default": false
      },
      {
        "name": "enableCheckButton",
        "type": "boolean",
        "label": "Enable \"Check\" button",
        "default": true
      },
      {
        "name": "enableSolutionsButton",
        "type": "boolean",
        "label": "Enable \"Show solution\" button",
        "default": true
      },
      {
        "name": "showSolutionsRequiresInput",
        "type": "boolean",
        "label": "Require all fields to be answered before the solution can be viewed",
        "default": true
      },
      {
        "name": "enableRetry",
        "type": "boolean",
        "label": "Enable \"Retry\"",
        "default": true
      },
      {
        "name": "confirmCheckDialog",
        "type": "boolean",
        "label": "Show confirmation dialog on \"Check\"",
        "default": false
      },
      {
        "name": "confirmRetryDialog",
        "type": "boolean",
        "label": "Show confirmation dialog on \"Retry\"",
        "default": false
      }
    ]
  },
  {
    "name": "l10n",
    "type": "group",
    "label": "User interface translations",
    "common": true,
    "importance": "low",
    "expanded": false,
    "fields": [
      { "name": "startFlash", "type": "text", "label": "Start flash button", "default": "Start image flash" },
      { "name": "repeatFlash", "type": "text", "label": "Repeat flash button", "default": "Show image again" },
      { "name": "loading", "type": "text", "label": "Loading message", "default": "Loading image…" },
      { "name": "checkAnswer", "type": "text", "label": "Check button", "default": "Check" },
      { "name": "showSolutions", "type": "text", "label": "Show solution button", "default": "Show solution" },
      { "name": "tryAgain", "type": "text", "label": "Retry button", "default": "Retry" },
      { "name": "notFilledOut", "type": "text", "label": "Not filled out message", "default": "Please fill in all blanks to view solution" },
      { "name": "tipLabel", "type": "text", "label": "Tip icon label", "default": "Tip" },
      { "name": "spellingMistakeWarning", "type": "text", "label": "Spelling mistake warning", "description": "Insert @mistake to show the misspelled word.", "default": "Check your spelling: @mistake" },
      { "name": "scoreBarLabel", "type": "text", "label": "Score bar text", "default": "You got :num out of :total points" }
    ]
  },
  {
    "name": "a11y",
    "type": "group",
    "label": "Accessibility translations",
    "common": true,
    "importance": "low",
    "expanded": false,
    "fields": [
      { "name": "flashImageLabel", "type": "text", "label": "Flash image region label", "default": "Flash image" },
      { "name": "flashStarted", "type": "text", "label": "Flash started announcement", "default": "Image flash started." },
      { "name": "flashEnded", "type": "text", "label": "Flash ended announcement", "default": "Image hidden. Answer the question." },
      { "name": "check", "type": "text", "label": "Check button description", "default": "Check the answers. The responses will be marked as correct, incorrect, or unanswered." },
      { "name": "showSolution", "type": "text", "label": "Show solution button description", "default": "Show the solution. The task will be marked with its correct solution." },
      { "name": "retry", "type": "text", "label": "Retry button description", "default": "Retry the task. Reset all responses and start the task over again." },
      { "name": "checkingMode", "type": "text", "label": "Checking mode description", "default": "Checking mode" }
    ]
  },
  {
    "name": "confirmCheck",
    "type": "group",
    "label": "Check confirmation dialog",
    "common": true,
    "importance": "low",
    "fields": [
      { "name": "header", "type": "text", "label": "Header text", "default": "Finish?" },
      { "name": "body", "type": "text", "label": "Body text", "default": "Are you sure you wish to finish?", "widget": "html", "enterMode": "p", "tags": ["strong", "em", "u"] },
      { "name": "cancelLabel", "type": "text", "label": "Cancel button label", "default": "Cancel" },
      { "name": "confirmLabel", "type": "text", "label": "Confirm button label", "default": "Finish" }
    ]
  },
  {
    "name": "confirmRetry",
    "type": "group",
    "label": "Retry confirmation dialog",
    "common": true,
    "importance": "low",
    "fields": [
      { "name": "header", "type": "text", "label": "Header text", "default": "Retry?" },
      { "name": "body", "type": "text", "label": "Body text", "default": "Are you sure you wish to retry?", "widget": "html", "enterMode": "p", "tags": ["strong", "em", "u"] },
      { "name": "cancelLabel", "type": "text", "label": "Cancel button label", "default": "Cancel" },
      { "name": "confirmLabel", "type": "text", "label": "Confirm button label", "default": "Confirm" }
    ]
  }
]
